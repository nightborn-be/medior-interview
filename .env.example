# Base de donnees locale (docker compose)
DATABASE_URL=postgres://steenland:steenland@localhost:5433/steenland

# Cle API Anthropic. Optionnelle : l'exercice ne demande aucun appel a un modele.
ANTHROPIC_API_KEY=

# Simulateur d'import ERP
# Dossier surveille par le job d'import et dossiers de sortie
ERP_DROP_DIR=./erp/drop
ERP_PROCESSED_DIR=./erp/processed
ERP_REJECTED_DIR=./erp/rejected
ERP_LOG_DIR=./erp/logs
# Frequence du job d'import (expression cron, parametre systeme)
ERP_IMPORT_CRON=0 23 * * *
